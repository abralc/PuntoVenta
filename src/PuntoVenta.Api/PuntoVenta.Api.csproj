<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>PuntoVenta.Api</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <!-- Hash de contraseñas -->
    <PackageReference Include="BCrypt.Net-Next" Version="4.0.3" />
    <!-- Autenticación JWT -->
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="10.0.8" />
    <!-- EF Core + MySQL. Pomelo 9 funciona sobre net10.0 (Pomelo 10 aún no es estable) -->
    <PackageReference Include="Pomelo.EntityFrameworkCore.MySql" Version="9.0.0" />
    <!-- Documentación y pruebas de la API con botón "Authorize" para JWT -->
    <PackageReference Include="Swashbuckle.AspNetCore" Version="9.0.4" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\PuntoVenta.Shared\PuntoVenta.Shared.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Mantener la carpeta de imágenes en la publicación aunque esté vacía -->
    <Content Update="wwwroot\images\productos\.gitkeep" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
