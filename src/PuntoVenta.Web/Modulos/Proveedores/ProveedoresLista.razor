@page "/proveedores"
@inject ApiService Api
@inject NotificacionService Notificar
@inject ConfirmacionService Confirmar

<PageTitle>Proveedores · Punto de Venta</PageTitle>

<EncabezadoPagina Titulo="Proveedores" Icono="bi-truck" Descripcion="Empresas a las que se compran los productos.">
    <Acciones>
        <a class="btn btn-outline-secondary" href="compras"><i class="bi bi-arrow-left me-1"></i>Regresar a Compras</a>
        <button class="btn btn-primary" @onclick="Nuevo"><i class="bi bi-plus-lg me-1"></i>Nuevo proveedor</button>
    </Acciones>
</EncabezadoPagina>

<div class="pv-card">
    <div class="pv-card-header d-flex flex-wrap gap-2 align-items-center">
        <div class="pv-ancho-buscador"><Buscador Placeholder="Buscar por nombre, NIT, dirección o teléfono..." AlBuscar="Buscar" /></div>
        <span class="ms-auto small text-secondary">@(_lista?.Count ?? 0) registros</span>
    </div>

    @if (_lista is null)
    {
        <Cargando />
    }
    else if (_lista.Count == 0)
    {
        <EstadoVacio Icono="bi-truck" Texto="No se encontraron proveedores." />
    }
    else
    {
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead>
                    <tr><th>Proveedor</th><th>NIT</th><th>Dirección</th><th>Teléfono</th><th class="text-center">Compras</th><th class="text-end">Acciones</th></tr>
                </thead>
                <tbody>
                    @foreach (var p in _lista.Skip((_pagina - 1) * TamanoPagina).Take(TamanoPagina))
                    {
                        <tr>
                            <td class="fw-semibold">@p.Proveedor</td>
                            <td class="text-nowrap">@p.Nit</td>
                            <td>@p.Direccion</td>
                            <td class="text-nowrap">@p.Telefono</td>
                            <td class="text-center"><span class="badge rounded-pill text-bg-light">@p.Compras</span></td>
                            <td class="text-end text-nowrap">
                                <button class="btn btn-sm btn-outline-primary" title="Editar" @onclick="() => Editar(p)"><i class="bi bi-pencil"></i></button>
                                <button class="btn btn-sm btn-outline-danger" title="Eliminar" @onclick="() => Eliminar(p)"><i class="bi bi-trash"></i></button>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
        <Paginacion Total="_lista.Count" @bind-Pagina="_pagina" TamanoPagina="TamanoPagina" />
    }
</div>

<Modal @bind-Visible="_modal" Titulo="@(_actual.IdProveedor == 0 ? "Nuevo proveedor" : "Editar proveedor")" Icono="bi-truck">
    <ChildContent>
        <AlertaErrores Error="_error" />
        <EditForm id="frmProveedor" Model="_actual" OnValidSubmit="Guardar">
            <DataAnnotationsValidator />
            <div class="row g-3">
                <div class="col-md-8">
                    <label class="form-label" for="proveedor">Nombre del proveedor *</label>
                    <InputText id="proveedor" class="form-control" @bind-Value="_actual.Proveedor" maxlength="60" />
                    <ValidationMessage For="() => _actual.Proveedor" />
                </div>
                <div class="col-md-4">
                    <label class="form-label" for="nit">NIT *</label>
                    <InputText id="nit" class="form-control text-uppercase" @bind-Value="_actual.Nit" maxlength="12" placeholder="1122334-5" />
                    <ValidationMessage For="() => _actual.Nit" />
                </div>
                <div class="col-md-8">
                    <label class="form-label" for="direccion">Dirección *</label>
                    <InputText id="direccion" class="form-control" @bind-Value="_actual.Direccion" maxlength="80" />
                    <ValidationMessage For="() => _actual.Direccion" />
                </div>
                <div class="col-md-4">
                    <label class="form-label" for="telefono">Teléfono *</label>
                    <InputText id="telefono" class="form-control" @bind-Value="_actual.Telefono" maxlength="25" placeholder="2201-1001" />
                    <ValidationMessage For="() => _actual.Telefono" />
                </div>
            </div>
        </EditForm>
    </ChildContent>
    <Pie>
        <button class="btn btn-light" @onclick="() => _modal = false">Cancelar</button>
        <button type="submit" form="frmProveedor" class="btn btn-primary" disabled="@_guardando">
            <i class="bi bi-check2 me-1"></i>Guardar
        </button>
    </Pie>
</Modal>

@code {
    private const int TamanoPagina = 10;
    private List<ProveedorDto>? _lista;
    private ProveedorDto _actual = new();
    private ApiException? _error;
    private string _buscar = string.Empty;
    private int _pagina = 1;
    private bool _modal, _guardando;

    protected override Task OnInitializedAsync() => Cargar();

    private async Task Cargar()
    {
        try { _lista = await Api.GetAsync<List<ProveedorDto>>($"api/proveedores?buscar={Uri.EscapeDataString(_buscar)}") ?? []; }
        catch (ApiException ex) { Notificar.Error(ex.Message); _lista = []; }
    }

    private async Task Buscar(string texto)
    {
        _buscar = texto;
        _pagina = 1;
        await Cargar();
    }

    private void Nuevo()
    {
        _actual = new ProveedorDto();
        _error = null;
        _modal = true;
    }

    private void Editar(ProveedorDto p)
    {
        _actual = new ProveedorDto
        {
            IdProveedor = p.IdProveedor, Proveedor = p.Proveedor, Nit = p.Nit, Direccion = p.Direccion, Telefono = p.Telefono
        };
        _error = null;
        _modal = true;
    }

    private async Task Guardar()
    {
        _guardando = true; _error = null;
        try
        {
            if (_actual.IdProveedor == 0)
                await Api.PostAsync("api/proveedores", _actual);
            else
                await Api.PutAsync($"api/proveedores/{_actual.IdProveedor}", _actual);

            Notificar.Exito($"Proveedor '{_actual.Proveedor}' guardado.");
            _modal = false;
            await Cargar();
        }
        catch (ApiException ex) { _error = ex; }
        finally { _guardando = false; }
    }

    private async Task Eliminar(ProveedorDto p)
    {
        if (!await Confirmar.PreguntarAsync("Eliminar proveedor", $"¿Desea eliminar a '{p.Proveedor}'?")) return;
        try
        {
            await Api.DeleteAsync($"api/proveedores/{p.IdProveedor}");
            Notificar.Exito("Proveedor eliminado.");
            await Cargar();
        }
        catch (ApiException ex) { Notificar.Error(ex.Message); }
    }
}
