@page "/clientes"
@inject ApiService Api
@inject NotificacionService Notificar
@inject ConfirmacionService Confirmar

<PageTitle>Clientes · Punto de Venta</PageTitle>

<EncabezadoPagina Titulo="Clientes" Icono="bi-people" Descripcion="Clientes a quienes se emiten las facturas de venta.">
    <Acciones>
        <a class="btn btn-outline-secondary" href="ventas"><i class="bi bi-receipt me-1"></i>Ir a Ventas</a>
        <button class="btn btn-primary" @onclick="Nuevo"><i class="bi bi-plus-lg me-1"></i>Nuevo cliente</button>
    </Acciones>
</EncabezadoPagina>

<div class="pv-card">
    <div class="pv-card-header d-flex flex-wrap gap-2 align-items-center">
        <div class="pv-ancho-buscador"><Buscador Placeholder="Buscar por nombre, NIT, teléfono o correo..." AlBuscar="Buscar" /></div>
        <span class="ms-auto small text-secondary">@(_lista?.Count ?? 0) registros</span>
    </div>

    @if (_lista is null)
    {
        <Cargando />
    }
    else if (_lista.Count == 0)
    {
        <EstadoVacio Icono="bi-people" Texto="No se encontraron clientes." />
    }
    else
    {
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead>
                    <tr><th>Cliente</th><th>NIT</th><th>Teléfono</th><th>Correo</th><th>Registro</th><th class="text-end">Acciones</th></tr>
                </thead>
                <tbody>
                    @foreach (var c in _lista.Skip((_pagina - 1) * TamanoPagina).Take(TamanoPagina))
                    {
                        <tr>
                            <td>
                                <div class="fw-semibold">@c.NombreCompleto</div>
                                <div class="small text-secondary">@(c.Genero ? "Masculino" : "Femenino")</div>
                            </td>
                            <td class="text-nowrap">
                                @if (c.Nit == "CF")
                                {
                                    <span class="badge text-bg-secondary">CF</span>
                                }
                                else
                                {
                                    @c.Nit
                                }
                            </td>
                            <td class="text-nowrap">@(c.Telefono ?? "-")</td>
                            <td>@(c.CorreoElectronico ?? "-")</td>
                            <td class="text-nowrap">@Fmt.Fecha(c.FechaIngreso)</td>
                            <td class="text-end text-nowrap">
                                <button class="btn btn-sm btn-outline-primary" title="Editar" @onclick="() => Editar(c)"><i class="bi bi-pencil"></i></button>
                                <button class="btn btn-sm btn-outline-danger" title="Eliminar" @onclick="() => Eliminar(c)"><i class="bi bi-trash"></i></button>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
        <Paginacion Total="_lista.Count" @bind-Pagina="_pagina" TamanoPagina="TamanoPagina" />
    }
</div>

<Modal @bind-Visible="_modal" Titulo="@(_actual.IdCliente == 0 ? "Nuevo cliente" : "Editar cliente")" Icono="bi-people">
    <ChildContent>
        <AlertaErrores Error="_error" />
        <EditForm id="frmCliente" Model="_actual" OnValidSubmit="Guardar">
            <DataAnnotationsValidator />
            <div class="row g-3">
                <div class="col-md-6">
                    <label class="form-label" for="nombres">Nombres *</label>
                    <InputText id="nombres" class="form-control" @bind-Value="_actual.Nombres" maxlength="60" />
                    <ValidationMessage For="() => _actual.Nombres" />
                </div>
                <div class="col-md-6">
                    <label class="form-label" for="apellidos">Apellidos *</label>
                    <InputText id="apellidos" class="form-control" @bind-Value="_actual.Apellidos" maxlength="60" />
                    <ValidationMessage For="() => _actual.Apellidos" />
                </div>
                <div class="col-md-6">
                    <label class="form-label" for="nit">NIT *</label>
                    <div class="input-group">
                        <InputText id="nit" class="form-control text-uppercase" @bind-Value="_actual.Nit" maxlength="12" placeholder="1234567-8 o CF" />
                        <button type="button" class="btn btn-outline-secondary" @onclick='() => _actual.Nit = "CF"'>CF</button>
                    </div>
                    <ValidationMessage For="() => _actual.Nit" />
                </div>
                <div class="col-md-6">
                    <label class="form-label d-block">Género *</label>
                    <InputRadioGroup TValue="bool" @bind-Value="_actual.Genero">
                        <div class="form-check form-check-inline mt-1">
                            <InputRadio TValue="bool" Value="true" class="form-check-input" id="cM" />
                            <label class="form-check-label" for="cM">Masculino</label>
                        </div>
                        <div class="form-check form-check-inline">
                            <InputRadio TValue="bool" Value="false" class="form-check-input" id="cF" />
                            <label class="form-check-label" for="cF">Femenino</label>
                        </div>
                    </InputRadioGroup>
                </div>
                <div class="col-md-6">
                    <label class="form-label" for="telefono">Teléfono</label>
                    <InputText id="telefono" class="form-control" @bind-Value="_actual.Telefono" maxlength="25" placeholder="4410-2201" />
                    <ValidationMessage For="() => _actual.Telefono" />
                </div>
                <div class="col-md-6">
                    <label class="form-label" for="correo">Correo electrónico</label>
                    <InputText id="correo" type="email" class="form-control" @bind-Value="_actual.CorreoElectronico" maxlength="45" placeholder="cliente@correo.com" />
                    <ValidationMessage For="() => _actual.CorreoElectronico" />
                </div>
            </div>
        </EditForm>
    </ChildContent>
    <Pie>
        <button class="btn btn-light" @onclick="() => _modal = false">Cancelar</button>
        <button type="submit" form="frmCliente" class="btn btn-primary" disabled="@_guardando">
            <i class="bi bi-check2 me-1"></i>Guardar
        </button>
    </Pie>
</Modal>

@code {
    private const int TamanoPagina = 10;
    private List<ClienteDto>? _lista;
    private ClienteDto _actual = new();
    private ApiException? _error;
    private string _buscar = string.Empty;
    private int _pagina = 1;
    private bool _modal, _guardando;

    protected override Task OnInitializedAsync() => Cargar();

    private async Task Cargar()
    {
        try { _lista = await Api.GetAsync<List<ClienteDto>>($"api/clientes?buscar={Uri.EscapeDataString(_buscar)}") ?? []; }
        catch (ApiException ex) { Notificar.Error(ex.Message); _lista = []; }
    }

    private async Task Buscar(string texto)
    {
        _buscar = texto;
        _pagina = 1;
        await Cargar();
    }

    private void Nuevo()
    {
        _actual = new ClienteDto();
        _error = null;
        _modal = true;
    }

    private void Editar(ClienteDto c)
    {
        _actual = new ClienteDto
        {
            IdCliente = c.IdCliente, Nombres = c.Nombres, Apellidos = c.Apellidos, Nit = c.Nit,
            Genero = c.Genero, Telefono = c.Telefono, CorreoElectronico = c.CorreoElectronico
        };
        _error = null;
        _modal = true;
    }

    private async Task Guardar()
    {
        _guardando = true; _error = null;
        try
        {
            if (_actual.IdCliente == 0)
                await Api.PostAsync("api/clientes", _actual);
            else
                await Api.PutAsync($"api/clientes/{_actual.IdCliente}", _actual);

            Notificar.Exito($"Cliente {_actual.NombreCompleto} guardado.");
            _modal = false;
            await Cargar();
        }
        catch (ApiException ex) { _error = ex; }
        finally { _guardando = false; }
    }

    private async Task Eliminar(ClienteDto c)
    {
        if (!await Confirmar.PreguntarAsync("Eliminar cliente", $"¿Desea eliminar a {c.NombreCompleto}?")) return;
        try
        {
            await Api.DeleteAsync($"api/clientes/{c.IdCliente}");
            Notificar.Exito("Cliente eliminado.");
            await Cargar();
        }
        catch (ApiException ex) { Notificar.Error(ex.Message); }
    }
}
