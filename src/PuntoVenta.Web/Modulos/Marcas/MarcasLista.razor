@page "/marcas"
@inject ApiService Api
@inject NotificacionService Notificar
@inject ConfirmacionService Confirmar

<PageTitle>Marcas · Punto de Venta</PageTitle>

<EncabezadoPagina Titulo="Marcas" Icono="bi-tags" Descripcion="Marcas que se asignan a los productos.">
    <Acciones>
        <a class="btn btn-outline-secondary" href="productos"><i class="bi bi-arrow-left me-1"></i>Regresar a Productos</a>
        <button class="btn btn-primary" @onclick="Nuevo"><i class="bi bi-plus-lg me-1"></i>Nueva marca</button>
    </Acciones>
</EncabezadoPagina>

<div class="pv-card">
    <div class="pv-card-header d-flex flex-wrap gap-2 align-items-center">
        <div class="pv-ancho-buscador"><Buscador Placeholder="Buscar marca..." AlBuscar="Buscar" /></div>
        <span class="ms-auto small text-secondary">@(_lista?.Count ?? 0) registros</span>
    </div>

    @if (_lista is null)
    {
        <Cargando />
    }
    else if (_lista.Count == 0)
    {
        <EstadoVacio Icono="bi-tags" Texto="No se encontraron marcas." />
    }
    else
    {
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead>
                    <tr><th style="width:80px">#</th><th>Marca</th><th class="text-center">Productos</th><th class="text-end">Acciones</th></tr>
                </thead>
                <tbody>
                    @foreach (var p in _lista.Skip((_pagina - 1) * TamanoPagina).Take(TamanoPagina))
                    {
                        <tr>
                            <td class="text-secondary">@p.IdMarca</td>
                            <td class="fw-semibold">@p.Marca</td>
                            <td class="text-center"><span class="badge rounded-pill text-bg-light">@p.Productos</span></td>
                            <td class="text-end text-nowrap">
                                <button class="btn btn-sm btn-outline-primary" title="Editar" @onclick="() => Editar(p)"><i class="bi bi-pencil"></i></button>
                                <button class="btn btn-sm btn-outline-danger" title="Eliminar" @onclick="() => Eliminar(p)"><i class="bi bi-trash"></i></button>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
        <Paginacion Total="_lista.Count" @bind-Pagina="_pagina" TamanoPagina="TamanoPagina" />
    }
</div>

<Modal @bind-Visible="_modal" Titulo="@(_actual.IdMarca == 0 ? "Nueva marca" : "Editar marca")" Icono="bi-tags" Tamano="">
    <ChildContent>
        <AlertaErrores Error="_error" />
        <EditForm id="frmMarca" Model="_actual" OnValidSubmit="Guardar">
            <DataAnnotationsValidator />
            <label class="form-label" for="marca">Nombre de la marca *</label>
            <InputText id="marca" class="form-control" @bind-Value="_actual.Marca" maxlength="50" />
            <ValidationMessage For="() => _actual.Marca" />
        </EditForm>
    </ChildContent>
    <Pie>
        <button class="btn btn-light" @onclick="() => _modal = false">Cancelar</button>
        <button type="submit" form="frmMarca" class="btn btn-primary" disabled="@_guardando">
            <i class="bi bi-check2 me-1"></i>Guardar
        </button>
    </Pie>
</Modal>

@code {
    private const int TamanoPagina = 10;
    private List<MarcaDto>? _lista;
    private MarcaDto _actual = new();
    private ApiException? _error;
    private string _buscar = string.Empty;
    private int _pagina = 1;
    private bool _modal, _guardando;

    protected override Task OnInitializedAsync() => Cargar();

    private async Task Cargar()
    {
        try { _lista = await Api.GetAsync<List<MarcaDto>>($"api/marcas?buscar={Uri.EscapeDataString(_buscar)}") ?? []; }
        catch (ApiException ex) { Notificar.Error(ex.Message); _lista = []; }
    }

    private async Task Buscar(string texto)
    {
        _buscar = texto;
        _pagina = 1;
        await Cargar();
    }

    private void Nuevo()
    {
        _actual = new MarcaDto();
        _error = null;
        _modal = true;
    }

    private void Editar(MarcaDto p)
    {
        _actual = new MarcaDto { IdMarca = p.IdMarca, Marca = p.Marca };
        _error = null;
        _modal = true;
    }

    private async Task Guardar()
    {
        _guardando = true; _error = null;
        try
        {
            if (_actual.IdMarca == 0)
                await Api.PostAsync("api/marcas", _actual);
            else
                await Api.PutAsync($"api/marcas/{_actual.IdMarca}", _actual);

            Notificar.Exito($"Marca '{_actual.Marca}' guardada.");
            _modal = false;
            await Cargar();
        }
        catch (ApiException ex) { _error = ex; }
        finally { _guardando = false; }
    }

    private async Task Eliminar(MarcaDto p)
    {
        if (!await Confirmar.PreguntarAsync("Eliminar marca", $"¿Desea eliminar la marca '{p.Marca}'?")) return;
        try
        {
            await Api.DeleteAsync($"api/marcas/{p.IdMarca}");
            Notificar.Exito("Marca eliminada.");
            await Cargar();
        }
        catch (ApiException ex) { Notificar.Error(ex.Message); }
    }
}
