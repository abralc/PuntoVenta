@page "/compras/nueva"
@page "/compras/{Id:int}"
@using PuntoVenta.Shared.Configuracion
@inject ApiService Api
@inject NotificacionService Notificar
@inject ConfirmacionService Confirmar
@inject NavigationManager Nav

<PageTitle>@(EsNueva ? "Nueva compra" : $"Compra #{_modelo.NoOrdenCompra}") · Punto de Venta</PageTitle>

<EncabezadoPagina Titulo="@(EsNueva ? "Nueva compra" : $"Orden de compra #{_modelo.NoOrdenCompra}")" Icono="bi-cart-plus"
                  Descripcion="Maestro (proveedor y orden) y detalle (productos) se guardan juntos en una sola operación.">
    <Acciones>
        <a class="btn btn-outline-secondary" href="compras"><i class="bi bi-arrow-left me-1"></i>Volver al listado</a>
    </Acciones>
</EncabezadoPagina>

@if (_cargando)
{
    <Cargando />
}
else
{
    <AlertaErrores Error="_error" />

    <EditForm id="frmCompra" Model="_modelo" OnValidSubmit="Guardar">
        <DataAnnotationsValidator />

        @* ---------------- MAESTRO ---------------- *@
        <div class="pv-card mb-3">
            <div class="pv-card-header fw-semibold"><i class="bi bi-file-earmark-text me-2"></i>Datos de la compra</div>
            <div class="pv-card-body">
                <div class="row g-3">
                    <div class="col-md-6">
                        <div class="d-flex justify-content-between align-items-end">
                            <label class="form-label" for="proveedor">Proveedor *</label>
                            <a class="small mb-2" href="proveedores"><i class="bi bi-box-arrow-up-right me-1"></i>Ir a Proveedores</a>
                        </div>
                        <InputSelect id="proveedor" class="form-select" @bind-Value="_modelo.IdProveedor">
                            <option value="0">-- Seleccione un proveedor --</option>
                            @foreach (var p in _proveedores)
                            {
                                <option value="@p.Id">@p.Texto</option>
                            }
                        </InputSelect>
                        <ValidationMessage For="() => _modelo.IdProveedor" />
                    </div>
                    <div class="col-6 col-md-3">
                        <label class="form-label" for="orden">No. de orden *</label>
                        <InputNumber id="orden" class="form-control" @bind-Value="_modelo.NoOrdenCompra" />
                        <ValidationMessage For="() => _modelo.NoOrdenCompra" />
                    </div>
                    <div class="col-6 col-md-3">
                        <label class="form-label" for="fecha">Fecha de la orden *</label>
                        <InputDate id="fecha" class="form-control" @bind-Value="_modelo.FechaOrden" />
                        <ValidationMessage For="() => _modelo.FechaOrden" />
                    </div>
                </div>
            </div>
        </div>
    </EditForm>

    @* ---------------- DETALLE ---------------- *@
    <div class="pv-card mb-3">
        <div class="pv-card-header fw-semibold"><i class="bi bi-list-check me-2"></i>Detalle de productos</div>
        <div class="pv-card-body border-bottom">
            <EditForm Model="_linea" OnValidSubmit="AgregarLinea" FormName="lineaCompra">
                <DataAnnotationsValidator />
                <div class="row g-2 align-items-end">
                    <div class="col-md-5">
                        <label class="form-label small mb-1" for="producto">Producto</label>
                        <InputSelect id="producto" class="form-select" @bind-Value="_linea.IdProducto" @bind-Value:after="ProductoSeleccionado">
                            <option value="0">-- Seleccione un producto --</option>
                            @foreach (var p in _productos)
                            {
                                <option value="@p.IdProducto">@p.Texto (exist. @p.Existencia)</option>
                            }
                        </InputSelect>
                        <ValidationMessage For="() => _linea.IdProducto" />
                    </div>
                    <div class="col-4 col-md-2">
                        <label class="form-label small mb-1" for="cantidad">Cantidad</label>
                        <InputNumber id="cantidad" class="form-control" @bind-Value="_linea.Cantidad" min="1" />
                        <ValidationMessage For="() => _linea.Cantidad" />
                    </div>
                    <div class="col-8 col-md-3">
                        <label class="form-label small mb-1" for="costo">Precio de costo unitario</label>
                        <div class="input-group">
                            <span class="input-group-text">Q</span>
                            <InputNumber id="costo" class="form-control" @bind-Value="_linea.PrecioCostoUnitario" step="0.01" />
                        </div>
                        <ValidationMessage For="() => _linea.PrecioCostoUnitario" />
                    </div>
                    <div class="col-md-2">
                        <button type="submit" class="btn btn-outline-primary w-100"><i class="bi bi-plus-circle me-1"></i>Agregar</button>
                    </div>
                </div>
                @if (Producto(_linea.IdProducto) is { } sel)
                {
                    <div class="small text-secondary mt-2">
                        Costo actual @Fmt.Q(sel.PrecioCosto) · Venta actual @Fmt.Q(sel.PrecioVenta) · Existencia @sel.Existencia
                    </div>
                }
            </EditForm>
        </div>

        @if (_modelo.Detalles.Count == 0)
        {
            <EstadoVacio Icono="bi-cart" Texto="Agregue los productos de la compra." />
        }
        else
        {
            <div class="table-responsive">
                <table class="table align-middle mb-0">
                    <thead>
                        <tr>
                            <th>Producto</th><th style="width:110px">Cantidad</th><th style="width:150px">Costo unit.</th>
                            <th class="text-end">Subtotal</th><th class="text-center">Existencia</th><th class="text-end">Nuevo precio venta</th><th></th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var d in _modelo.Detalles)
                        {
                            var p = Producto(d.IdProducto);
                            <tr>
                                <td>
                                    <div class="d-flex align-items-center gap-2">
                                        <img class="pv-miniatura" src="@Api.UrlImagen(p?.Imagen)" alt="" />
                                        <div>
                                            <div class="fw-semibold">@p?.Producto</div>
                                            <div class="small text-secondary">@p?.Marca</div>
                                        </div>
                                    </div>
                                </td>
                                <td><input type="number" min="1" class="form-control form-control-sm" @bind="d.Cantidad" @bind:event="oninput" /></td>
                                <td>
                                    <div class="input-group input-group-sm">
                                        <span class="input-group-text">Q</span>
                                        <input type="number" min="0.01" step="0.01" class="form-control" @bind="d.PrecioCostoUnitario" @bind:event="oninput" />
                                    </div>
                                </td>
                                <td class="text-end text-nowrap">@Fmt.Q(Math.Round(d.Cantidad * d.PrecioCostoUnitario, 2))</td>
                                <td class="text-center text-nowrap small">
                                    @ExistenciaActual(d.IdProducto) <i class="bi bi-arrow-right"></i>
                                    <strong class="text-success">@(ExistenciaActual(d.IdProducto) + d.Cantidad)</strong>
                                </td>
                                <td class="text-end text-nowrap">
                                    <span class="fw-semibold text-primary">@Fmt.Q(PrecioVenta(d.PrecioCostoUnitario))</span>
                                    <div class="small text-secondary">+@_porcentaje.ToString("0.##") %</div>
                                </td>
                                <td class="text-end">
                                    <button class="btn btn-sm btn-outline-danger" title="Quitar" @onclick="() => QuitarLinea(d)"><i class="bi bi-x-lg"></i></button>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>

    @* ---------------- TOTALES Y ACCIONES ---------------- *@
    <div class="pv-card">
        <div class="pv-card-body d-flex flex-wrap align-items-center gap-3">
            <div class="pv-total-bloque">
                <span>Productos</span><strong>@_modelo.Detalles.Count</strong>
            </div>
            <div class="pv-total-bloque">
                <span>Unidades</span><strong>@_modelo.Detalles.Sum(d => d.Cantidad)</strong>
            </div>
            <div class="pv-total-bloque pv-total-principal">
                <span>Total de la compra</span><strong>@Fmt.Q(Total)</strong>
            </div>
            <div class="ms-auto d-flex gap-2">
                @if (!EsNueva)
                {
                    <button class="btn btn-outline-danger" @onclick="Eliminar" disabled="@_guardando"><i class="bi bi-trash me-1"></i>Eliminar</button>
                }
                <button type="submit" form="frmCompra" class="btn btn-primary btn-lg" disabled="@(_guardando || _modelo.Detalles.Count == 0)">
                    @if (_guardando)
                    {
                        <span class="spinner-border spinner-border-sm me-1"></span>
                    }
                    <i class="bi bi-check2-circle me-1"></i>@(EsNueva ? "Registrar compra" : "Guardar cambios")
                </button>
            </div>
        </div>
    </div>
}

@code {
    [Parameter] public int? Id { get; set; }

    private bool EsNueva => Id is null;

    private CompraGuardarDto _modelo = new();
    private CompraDetalleGuardarDto _linea = new();
    private List<OpcionDto> _proveedores = [];
    private List<ProductoOpcionDto> _productos = [];
    private Dictionary<int, int> _cantidadOriginal = [];   // al editar: lo que esta compra ya sumó a la existencia
    private decimal _porcentaje = 25;
    private ApiException? _error;
    private bool _cargando = true, _guardando;

    private decimal Total => _modelo.Detalles.Sum(d => Math.Round(d.Cantidad * d.PrecioCostoUnitario, 2));

    private ProductoOpcionDto? Producto(int id) => _productos.FirstOrDefault(p => p.IdProducto == id);

    /// <summary>Existencia sin contar lo que esta misma compra ya había sumado.</summary>
    private int ExistenciaActual(int idProducto) =>
        (Producto(idProducto)?.Existencia ?? 0) - _cantidadOriginal.GetValueOrDefault(idProducto);

    private decimal PrecioVenta(decimal costo) => Math.Round(costo * (1 + _porcentaje / 100m), 2, MidpointRounding.AwayFromZero);

    protected override async Task OnInitializedAsync()
    {
        try
        {
            _proveedores = await Api.GetAsync<List<OpcionDto>>("api/proveedores/opciones") ?? [];
            _productos = await Api.GetAsync<List<ProductoOpcionDto>>("api/productos/opciones") ?? [];
            _porcentaje = (await Api.GetAsync<ConfiguracionDto>("api/configuracion"))?.PorcentajeGanancia ?? 25;

            if (EsNueva)
            {
                _modelo.NoOrdenCompra = await Api.GetAsync<int>("api/compras/siguiente-orden");
                _modelo.FechaOrden = DateOnly.FromDateTime(DateTime.Today);
            }
            else
            {
                var compra = await Api.GetAsync<CompraDto>($"api/compras/{Id}");
                if (compra is not null)
                {
                    _modelo = new CompraGuardarDto
                    {
                        NoOrdenCompra = compra.NoOrdenCompra,
                        IdProveedor = compra.IdProveedor,
                        FechaOrden = compra.FechaOrden,
                        Detalles = compra.Detalles.Select(d => new CompraDetalleGuardarDto
                        {
                            IdProducto = d.IdProducto, Cantidad = d.Cantidad, PrecioCostoUnitario = d.PrecioCostoUnitario
                        }).ToList()
                    };
                    _cantidadOriginal = compra.Detalles.ToDictionary(d => d.IdProducto, d => d.Cantidad);
                }
            }
        }
        catch (ApiException ex) { _error = ex; }
        finally { _cargando = false; }
    }

    private void ProductoSeleccionado()
    {
        // Sugerir el costo actual del producto
        if (Producto(_linea.IdProducto) is { } p && p.PrecioCosto > 0)
            _linea.PrecioCostoUnitario = p.PrecioCosto;
    }

    private void AgregarLinea()
    {
        var existente = _modelo.Detalles.FirstOrDefault(d => d.IdProducto == _linea.IdProducto);
        if (existente is not null)
        {
            existente.Cantidad += _linea.Cantidad;
            existente.PrecioCostoUnitario = _linea.PrecioCostoUnitario;
            Notificar.Info("El producto ya estaba en el detalle: se sumó la cantidad.");
        }
        else
        {
            _modelo.Detalles.Add(new CompraDetalleGuardarDto
            {
                IdProducto = _linea.IdProducto, Cantidad = _linea.Cantidad, PrecioCostoUnitario = _linea.PrecioCostoUnitario
            });
        }
        _linea = new CompraDetalleGuardarDto();
    }

    private void QuitarLinea(CompraDetalleGuardarDto d) => _modelo.Detalles.Remove(d);

    private async Task Guardar()
    {
        var invalida = _modelo.Detalles.FirstOrDefault(d => d.Cantidad <= 0 || d.PrecioCostoUnitario <= 0);
        if (invalida is not null)
        {
            Notificar.Advertencia($"Revise '{Producto(invalida.IdProducto)?.Producto}': cantidad y costo deben ser mayores a cero.");
            return;
        }

        _guardando = true; _error = null;
        try
        {
            if (EsNueva)
                await Api.PostAsync("api/compras", _modelo);
            else
                await Api.PutAsync($"api/compras/{Id}", _modelo);

            Notificar.Exito($"Compra #{_modelo.NoOrdenCompra} guardada. Existencias, costos y precios de venta actualizados.");
            Nav.NavigateTo("compras");
        }
        catch (ApiException ex) { _error = ex; }
        finally { _guardando = false; }
    }

    private async Task Eliminar()
    {
        if (!await Confirmar.PreguntarAsync("Eliminar compra", $"¿Eliminar la orden #{_modelo.NoOrdenCompra}? Se descontarán las unidades de la existencia.")) return;
        _guardando = true;
        try
        {
            await Api.DeleteAsync($"api/compras/{Id}");
            Notificar.Exito("Compra eliminada y existencias revertidas.");
            Nav.NavigateTo("compras");
        }
        catch (ApiException ex) { Notificar.Error(ex.Message); }
        finally { _guardando = false; }
    }
}
