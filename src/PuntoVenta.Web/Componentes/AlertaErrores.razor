@* Muestra el error devuelto por la API (mensaje + errores por campo). *@

@if (Error is not null)
{
    <div class="alert alert-danger py-2 d-flex gap-2" role="alert">
        <i class="bi bi-exclamation-octagon mt-1"></i>
        <div>
            <div class="fw-semibold">@Error.Message</div>
            @if (Error.Errores is { Count: > 0 })
            {
                <ul class="mb-0 small ps-3">
                    @foreach (var mensaje in Error.Errores.SelectMany(e => e.Value).Distinct())
                    {
                        <li>@mensaje</li>
                    }
                </ul>
            }
        </div>
    </div>
}

@code {
    [Parameter] public ApiException? Error { get; set; }
}
