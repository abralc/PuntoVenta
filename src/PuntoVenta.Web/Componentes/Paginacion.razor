@* Paginación del lado del cliente.
   <Paginacion Total="_filtrados.Count" @bind-Pagina="_pagina" TamanoPagina="10" />
   y en la tabla: _filtrados.Skip((_pagina - 1) * 10).Take(10) *@

@if (Total > 0)
{
    <div class="d-flex flex-wrap align-items-center justify-content-between gap-2 px-3 py-2 border-top small text-secondary">
        <span>Mostrando @Desde–@Hasta de @Total</span>
        @if (TotalPaginas > 1)
        {
            <nav aria-label="Paginación">
                <ul class="pagination pagination-sm mb-0">
                    <li class="page-item @(Pagina <= 1 ? "disabled" : "")">
                        <button class="page-link" @onclick="() => Ir(Pagina - 1)" aria-label="Anterior"><i class="bi bi-chevron-left"></i></button>
                    </li>
                    @foreach (var p in Paginas())
                    {
                        <li class="page-item @(p == Pagina ? "active" : "")">
                            <button class="page-link" @onclick="() => Ir(p)">@p</button>
                        </li>
                    }
                    <li class="page-item @(Pagina >= TotalPaginas ? "disabled" : "")">
                        <button class="page-link" @onclick="() => Ir(Pagina + 1)" aria-label="Siguiente"><i class="bi bi-chevron-right"></i></button>
                    </li>
                </ul>
            </nav>
        }
    </div>
}

@code {
    [Parameter] public int Total { get; set; }
    [Parameter] public int Pagina { get; set; } = 1;
    [Parameter] public EventCallback<int> PaginaChanged { get; set; }
    [Parameter] public int TamanoPagina { get; set; } = 10;

    private int TotalPaginas => Math.Max(1, (int)Math.Ceiling(Total / (double)TamanoPagina));
    private int Desde => Total == 0 ? 0 : (Pagina - 1) * TamanoPagina + 1;
    private int Hasta => Math.Min(Total, Pagina * TamanoPagina);

    private IEnumerable<int> Paginas()
    {
        var inicio = Math.Max(1, Pagina - 2);
        var fin = Math.Min(TotalPaginas, inicio + 4);
        inicio = Math.Max(1, fin - 4);
        return Enumerable.Range(inicio, fin - inicio + 1);
    }

    private Task Ir(int pagina)
    {
        pagina = Math.Clamp(pagina, 1, TotalPaginas);
        return pagina == Pagina ? Task.CompletedTask : PaginaChanged.InvokeAsync(pagina);
    }
}
